    "Notes in the Trash are deleted after 30 days. A backup is made at every launch.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف الملاحظات الموجودة في سلة المهملات بعد 30 يومًا. تُنشأ نسخة احتياطية عند كل تشغيل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de la paperera s'eliminen al cap de 30 dies. Es fa una còpia de seguretat a cada inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky v koši se smažou po 30 dnech. Při každém spuštění se vytvoří záloha."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter i papirkurven slettes efter 30 dage. Der tages en sikkerhedskopi ved hver start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen im Papierkorb werden nach 30 Tagen gelöscht. Bei jedem Start wird ein Backup erstellt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις στον Κάδο διαγράφονται μετά από 30 ημέρες. Δημιουργείται αντίγραφο ασφαλείας σε κάθε εκκίνηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de la papelera se eliminan a los 30 días. Se hace una copia de seguridad en cada arranque."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskakorissa olevat muistiinpanot poistetaan 30 päivän kuluttua. Varmuuskopio tehdään jokaisella käynnistyskerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de la corbeille sont supprimées après 30 jours. Une sauvegarde est faite à chaque lancement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתקים בפח נמחקים לאחר 30 יום. גיבוי נוצר בכל הפעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में मौजूद नोट्स 30 दिनों के बाद डिलीट हो जाते हैं। हर लॉन्च पर बैकअप बनाया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilješke u smeću brišu se nakon 30 dana. Sigurnosna kopija izrađuje se pri svakom pokretanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukában lévő jegyzetek 30 nap után törlődnek. Minden indításkor biztonsági mentés készül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan di Tong Sampah dihapus setelah 30 hari. Cadangan dibuat setiap kali app dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note nel Cestino vengono eliminate dopo 30 giorni. A ogni avvio viene creato un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内のメモは30日後に削除されます。起動するたびにバックアップが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통의 메모는 30일 후에 삭제됩니다. 실행할 때마다 백업이 생성됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dalam Tong Sampah dipadam selepas 30 hari. Sandaran dibuat setiap kali dilancarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notater i papirkurven slettes etter 30 dager. Det tas en sikkerhetskopi ved hver oppstart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities in de prullenmand worden na 30 dagen verwijderd. Bij elke start wordt een reservekopie gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatki w koszu są usuwane po 30 dniach. Przy każdym uruchomieniu tworzona jest kopia zapasowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas no Lixo são apagadas após 30 dias. Um backup é feito a cada abertura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas no Lixo são apagadas após 30 dias. É feita uma cópia de segurança em cada arranque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele din coș sunt șterse după 30 de zile. La fiecare lansare se face o copie de rezervă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки в Корзине удаляются через 30 дней. Резервная копия создается при каждом запуске."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámky v koši sa vymažú po 30 dňoch. Pri každom spustení sa vytvorí záloha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningar i papperskorgen raderas efter 30 dagar. En säkerhetskopia görs vid varje start."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตในถังขยะจะถูกลบหลังจาก 30 วัน ระบบจะสำรองข้อมูลทุกครั้งที่เปิดแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'ndeki notlar 30 gün sonra silinir. Her açılışta bir yedek alınır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотатки в Смітнику видаляються через 30 днів. Резервна копія створюється під час кожного запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú trong Thùng rác sẽ bị xóa sau 30 ngày. Một bản sao lưu được tạo mỗi lần khởi chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的备忘录会在 30 天后删除。每次启动时都会进行备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶中的備忘錄會在 30 天後刪除。每次啟動時都會進行備份。"
          }
        }
      }
    },
