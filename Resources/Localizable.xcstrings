    "Like Notes: tick circles, bullets and titles, no visible symbols.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل الملاحظات: دوائر للتحديد ونقاط وعناوين، دون رموز ظاهرة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Notes: cercles per marcar, pics i títols, sense símbols visibles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako v Poznámkách: kroužky k zaškrtnutí, odrážky a nadpisy, žádné viditelné symboly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Noter: afkrydsningscirkler, punkttegn og titler, ingen synlige symboler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Notizen: Abhakkreise, Aufzählungspunkte und Titel, keine sichtbaren Symbole."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όπως στις Σημειώσεις: κύκλοι επιλογής, κουκκίδες και τίτλοι, χωρίς ορατά σύμβολα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Notas: círculos para marcar, viñetas y títulos, sin símbolos visibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten Muistiinpanoissa: valintaympyrät, luettelomerkit ja otsikot, ei näkyviä symboleita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme Notes : ronds à cocher, puces et titres, sans symboles visibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמו בפתקים: עיגולי סימון, תבליטים וכותרות, ללא סמלים גלויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट्स की तरह: चेक करने के लिए गोले, बुलेट और शीर्षक, बिना दिखने वाले चिह्नों के।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kao Bilješke: kružići za označavanje, grafičke oznake i naslovi, bez vidljivih simbola."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint a Jegyzetekben: pipálható körök, felsorolásjelek és címek, látható szimbólumok nélkül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti Catatan: lingkaran centang, butir, dan judul, tanpa simbol yang terlihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come Note: cerchi da spuntare, elenchi puntati e titoli, nessun simbolo visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモのように：チェック用の丸、箇条書き、タイトルを表示し、記号は表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모 앱처럼: 체크 원, 글머리 기호 및 제목을 표시하고 기호는 보이지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti Nota: bulatan tanda, titik bulet dan tajuk, tanpa simbol kelihatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Notater: avkrysningssirkler, punkter og titler, ingen synlige symboler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals Notities: afvinkrondjes, opsommingstekens en titels, geen zichtbare symbolen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak w Notatkach: kółka do zaznaczania, punktory i tytuły, bez widocznych symboli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Notas: círculos para marcar, marcadores e títulos, sem símbolos visíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como a app Notas: círculos para assinalar, marcas e títulos, sem símbolos visíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca în Notițe: cercuri de bifat, buline și titluri, fără simboluri vizibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в Заметках: кружки для отметки, маркеры и заголовки без видимых символов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako v Poznámkach: krúžky na odškrtnutie, odrážky a nadpisy, žiadne viditeľné symboly."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Anteckningar: bockcirklar, punkter och rubriker, inga synliga symboler."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือนแอปโน้ต: วงกลมให้ติ๊ก สัญลักษณ์แสดงหัวข้อย่อย และหัวเรื่อง โดยไม่เห็นสัญลักษณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlar gibi: işaret daireleri, madde imleri ve başlıklar; görünür sembol yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як у Нотатках: кружечки для позначення, маркери й заголовки без видимих символів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giống Ghi chú: vòng tròn đánh dấu, dấu đầu dòng và tiêu đề, không hiện ký hiệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像“备忘录”一样：勾选圆圈、项目符号和标题，不显示符号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如同「備忘錄」：勾選圓圈、項目符號和標題，不顯示符號。"
          }
        }
      }
    },
